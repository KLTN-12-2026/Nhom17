# 6. Roadmap checkout testing (local only)
# Set this to true in .env.local to enable simulated payment confirmation.
# Never enable simulated payments in production.
ROADMAP_DEMO_PAYMENTS=false

# 7. VietQR + SePay (real bank QR transfer without VNPay sandbox)
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
# API Token from SePay (works on localhost without ngrok)
SEPAY_API_TOKEN=
# Webhook API Key (used when deployed or with ngrok)
SEPAY_WEBHOOK_API_KEY=

