//.env.example
# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV EXAMPLE)
# Đồ án Tốt nghiệp: Hệ thống Trắc nghiệm AI - Nhóm 17 (ĐH Duy Tân)
# ==========================================

# 1. Cơ sở dữ liệu MongoDB
MONGODB_URI="mongodb://localhost:27017/ai-quiz"

# 2. Xác thực NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-replace-me"

# 3. Google OAuth 2.0 (Social Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. Mã bảo mật đăng ký Giảng viên (Instructor Secret Verification Key)
INSTRUCTOR_SECRET_KEY="DTU-TEACHER-2026"

# 4. Cấu hình AI Engines (Gemini / OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 5. Cấu hình gửi Email OTP qua SMTP (Gmail App Password)
APP_URL="http://localhost:3000"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Trắc Nghiệm AI <your-email@gmail.com>"
